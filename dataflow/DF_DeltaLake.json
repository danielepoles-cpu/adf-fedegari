{
	"name": "DF_DeltaLake",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DS_ASQL_CORSI_GENERIC",
						"type": "DatasetReference"
					},
					"name": "DFDeltaLake"
				}
			],
			"sinks": [
				{
					"linkedService": {
						"referenceName": "LS_AS_CORSI",
						"type": "LinkedServiceReference"
					},
					"name": "SINK"
				}
			],
			"transformations": [
				{
					"name": "select1"
				}
			],
			"scriptLines": [
				"parameters{",
				"     NomeTabella as string",
				"}",
				"source(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> DFDeltaLake",
				"DFDeltaLake select(mapColumn(",
				"          each(match(true()),",
				"               replace($$,' ','_') = $$)",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> select1",
				"select1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     format: 'delta',",
				"     compressionType: 'snappy',",
				"     compressionLevel: 'Optimal',",
				"     fileSystem: 'medallion',",
				"     folderPath: (concat('bronze/',$NomeTabella)),",
				"     deltaTruncate: true,",
				"     mergeSchema: false,",
				"     autoCompact: true,",
				"     optimizedWrite: true,",
				"     vacuum: 1,",
				"     deletable: false,",
				"     insertable: true,",
				"     updateable: false,",
				"     upsertable: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> SINK"
			]
		}
	}
}